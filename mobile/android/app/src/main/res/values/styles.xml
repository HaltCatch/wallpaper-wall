<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#b7d2ff</item>
        <item name="android:navigationBarColor">#090b10</item>
    </style>
    <!-- Fully transparent host for SetWallpaperActivity so the deep link applies
         the wallpaper without a visible app switch. The dialog fallback (legacy
         links) still renders on top of the transparent window. -->
    <style name="TransparentTheme" parent="android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:colorAccent">#b7d2ff</item>
    </style>
</resources>
