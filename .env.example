# Docker Compose 对外暴露的 HTTP 端口。
WALLPAPER_PORT=4000

# 浏览器访问本站的公开来源（协议 + 域名，不含结尾斜杠）。多层反向代理下用于登录、注册与 CSRF 同源校验。
WALLPAPER_PUBLIC_ORIGIN=https://service.example.com

# 图片根目录：可填绝对路径，或相对于本 compose 文件的路径；Docker 将以只读方式挂载。
# Windows 示例：D:/Wallpapers
WALLPAPER_IMAGES_DIR=/mnt/data/docker/wallpaper_wall/images

# 可选：RustFS / CDN 的公开图片地址；使用 Docker、本地或局域网图片地址时留空。
WALLPAPER_PUBLIC_IMAGE_BASE_URL=

# Homepage 全局背景同步：URL 必须是 Homepage Compose 内网可访问的同步服务，
# Secret 与 Homepage 项目的 HOMEPAGE_WALLPAPER_SYNC_SECRET 必须完全相同（至少 32 字符）。
WALLPAPER_HOMEPAGE_SYNC_URL=
WALLPAPER_HOMEPAGE_SYNC_SECRET=

# 下载地址留空时，页面使用镜像内置的 /public/downloads；如使用 RustFS / CDN，再填写公开下载根地址。
WALLPAPER_DOWNLOADS_BASE_URL=/public/downloads

# 桌面端 / 移动端壁纸助手使用的自定义协议名。
WALLPAPER_AGENT_SCHEME=wallpaperwall

# 账户认证：local（内置账号）、oidc（仅 OIDC）、hybrid（两者并用）或 disabled。
# 默认 local，系统图库仍可匿名浏览。密钥留空时会在数据卷自动生成；也可用 `openssl rand -base64 48` 显式配置。
WALLPAPER_AUTH_MODE=local
WALLPAPER_SESSION_SECRET=
# 是否允许访客自行注册本地账号；关闭后已有本地账号仍可登录。
WALLPAPER_LOCAL_REGISTRATION=true
# 可选邀请码（英文逗号分隔）。留空则开放注册；填写后自助注册必须提供有效邀请码。
# 码可多次使用，适合在开放与关闭注册之间做轻量准入控制。
WALLPAPER_INVITE_CODES=
# 单个来源或账号在时间窗口内允许的登录/注册尝试次数。
WALLPAPER_AUTH_RATE_LIMIT_ATTEMPTS=10
WALLPAPER_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# 每个登录账号每分钟允许的上传次数；0 表示不限制。
WALLPAPER_UPLOAD_RATE_LIMIT_PER_MINUTE=60
# 本地管理员用户名，多个值用英文逗号分隔。
WALLPAPER_ADMIN_LOCAL_USERS=
WALLPAPER_OIDC_ISSUER=
WALLPAPER_OIDC_CLIENT_ID=
WALLPAPER_OIDC_CLIENT_SECRET=
# 留空时由 WALLPAPER_PUBLIC_ORIGIN 推导为 <origin>/api/v1/auth/callback；也可显式覆盖。
WALLPAPER_OIDC_REDIRECT_URI=
# 管理员稳定身份，格式为 issuer|subject，多个值用英文逗号分隔。
WALLPAPER_ADMIN_SUBJECTS=

# 用户上传存储：local 使用 Docker 命名卷；s3 支持 AWS S3、MinIO、RustFS 等兼容服务。
WALLPAPER_STORAGE_DRIVER=local
WALLPAPER_S3_ENDPOINT=
WALLPAPER_S3_BUCKET=
WALLPAPER_S3_REGION=us-east-1
WALLPAPER_S3_ACCESS_KEY=
WALLPAPER_S3_SECRET_KEY=
WALLPAPER_S3_FORCE_PATH_STYLE=true

WALLPAPER_UPLOAD_MAX_BYTES=104857600
# 每个用户的原图与缩略图总配额；默认 2 GiB，设为 0 表示不限制。
WALLPAPER_USER_STORAGE_QUOTA_BYTES=2147483648
WALLPAPER_MEDIA_URL_TTL_SECONDS=300
# 在 TLS 反向代理之后务必设为 true；本机 http://localhost 开发时改为 false。
WALLPAPER_COOKIE_SECURE=true
