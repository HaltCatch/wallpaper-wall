{
  "name": "wallpaper-wall-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/compress.mjs",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview:demo": "vite preview --config vite.demo.config.ts --host 127.0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "jsdom": "30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/HaltCatch/wallpaper-wall.git"
  }
}
